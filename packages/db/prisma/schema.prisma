generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tabla mínima de fundación: demuestra el flujo de migraciones.
// El dominio real (negocios, profesionales, turnos) llega en changes de producto.
model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
