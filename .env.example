# Copiar a .env y completar. Nunca commitear el .env real.
# Puerto 5433 del host (ver docker-compose.yml: evita colisión con
# un PostgreSQL nativo que pueda estar en 5432).
DATABASE_URL=postgresql://peluquita:peluquita@localhost:5433/peluquita?schema=public

# Puerto de apps/api en dev (la web usa 3000 fijo en su script dev).
PORT=3001
